 std::cout << "Message from thread " << id << "\n"; 
} 
void notifyFunction() { 
 std::this_thread::sleep_for(std::chrono::milliseconds(100)); 
 flag = 1; 
 cv.notify_one(); 
} 
int main() { 
 std::thread t1(waitFunction, 1); 
 std::thread t2(waitFunction, 2); 
 std::thread t3(waitFunction, 3); 
 std::thread notifier(notifyFunction); 
 t1.join(); 
 t2.join(); 
 t3.join(); 
 notifier.join(); 
 return 0; 
}


