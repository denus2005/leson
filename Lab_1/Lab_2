#include <iostream> 
#include <thread> 
#include <queue> 
#include <mutex> 
#include <chrono> 
#include <cmath> 
std::queue<int> dataQueue; 
std::mutex mtx; 
bool isDataReady = false; 
bool isPrime(int number) { 
 if (number <= 1) return false; 
 for (int i = 2; i <= std::sqrt(number); ++i) { 
 if (number % i == 0) return false; 
 } 
 return true; 
} 
void prepareData() { 
 int num; 
 while (std::cin >> num) { 
 std::unique_lock<std::mutex> lock(mtx); 
 dataQueue.push(num); 
 } 
 std::unique_lock<std::mutex> lock(mtx); 
 isDataReady = true; 
} 
void processData() { 
 while (true) { 
 std::unique_lock<std::mutex> lock(mtx); 
 if (isDataReady && dataQueue.empty()) { 
 break; 
 } 
 if (!dataQueue.empty()) { 
 int num = dataQueue.front(); 
 dataQueue.pop(); 
 if (isPrime(num)) { 
 std::cout << "Prime number: " << num << std::endl; 
 } 
 } else { 
 lock.unlock(); 
 std::this_thread::sleep_for(std::chrono::milliseconds(100)); 
 }
 } 
} 
int main() { 
 std::thread preparationThread(prepareData); 
 std::thread processingThread(processData); 
 preparationThread.detach(); 
 processingThread.join(); 
 return 0; 
} 


