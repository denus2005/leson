 if (number <= 1) return false; 
 for (int i = 2; i <= std::sqrt(number); ++i) { 
 if (number % i == 0) return false; 
 } 
 return true; 
} 
void dataPreparation() { 
 int num; 
 while (std::cin >> num) { 
 { 
 std::unique_lock<std::mutex> lock(mtx); 
 dataQueue.push(num); 
 } 
 cv.notify_one();  
 } 
 { 
 std::unique_lock<std::mutex> lock(mtx); 
 isDataReady = true;  
 } 
 cv.notify_all(); 
} 
void dataProcessing() { 
